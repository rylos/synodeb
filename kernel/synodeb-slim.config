# synodeb kernel — slim configuration, applied after synodeb.config.
# Drops subsystems that cannot be useful on the NAS: no framebuffer or other GPU drivers
# (only i915, for the Intel iGPU of the DS920+), no audio, Wi-Fi, Bluetooth, TV/webcam, laptop or tablet buses, other vendors'
# platforms, Xen/Hyper-V guest. Kept: all storage, wired networking
# (Realtek, Aquantia and, for the Synology E10G/E25G PCIe cards, Intel and Mellanox; Intel
# is also needed for QEMU), full USB (storage, serial, network, HID), KVM, containers,
# netfilter, filesystems.
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_CFG80211 is not set
# CONFIG_BT is not set
# CONFIG_SOUND is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_RC_CORE is not set
# CONFIG_STAGING is not set
# CONFIG_CAN is not set
# CONFIG_NFC is not set
# CONFIG_WWAN is not set
# CONFIG_INFINIBAND is not set
# CONFIG_PCMCIA is not set
# CONFIG_FIREWIRE is not set
# CONFIG_IIO is not set
# CONFIG_MTD is not set
# CONFIG_ATM is not set
# CONFIG_IEEE802154 is not set
# CONFIG_USB4 is not set
# CONFIG_COMEDI is not set
# CONFIG_SOUNDWIRE is not set
# CONFIG_HID_SENSOR_HUB is not set
# CONFIG_PARPORT is not set
# CONFIG_ACCESSIBILITY is not set
# CONFIG_GNSS is not set
# GPU: only i915 (Intel UHD 600 of the DS920+: VA-API/QSV transcoding, OpenCL, intel_gpu_top),
# as modules. No framebuffer console (headless, CONFIG_FB off), no other GPU or accelerator
# drivers, no GVT-g (not supported on Gemini Lake).
CONFIG_DRM=m
CONFIG_DRM_I915=m
# CONFIG_DRM_I915_GVT is not set
# CONFIG_DRM_I915_GVT_KVMGT is not set
# CONFIG_DRM_XE is not set
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_RADEON is not set
