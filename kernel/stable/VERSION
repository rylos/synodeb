# synodeb kernel, "stable" series: the newest x.y released on kernel.org (7.3, 7.3.1, ...).
# KVER is the upstream version (kernel.org tarball name), ABI is bumped on every published
# build, so the previous kernel stays installed next to the new one and serves as
# DEBIAN_OLD on the DOM. The kernel is named <upstream x.y.z>-<ABI>-ds923 (e.g.
# 7.3.0-1-ds923, package linux-image-7.3.0-1-ds923); metapackage linux-image-ds923-stable.
# .github/workflows/kernel.yml updates KVER and ABI when a new release of the series is out.
# Moving to the next series (7.4) is done by hand: kernel/patches/<x.y> and
# kernel/config-debian-<x.y> must exist for it.
SERIES=stable
KVER=7.3.1
ABI=4
# derived
KMAJ=${KVER%%.*}; KMIN=${KVER#*.}; KMIN=${KMIN%%.*}
KBRANCH=$KMAJ.$KMIN             # 7.3: kernel/patches/7.3, kernel/config-debian-7.3
KUPS=$KVER; case $KUPS in *.*.*) ;; *) KUPS=$KUPS.0 ;; esac
KREL=$KUPS-$ABI-ds923           # uname -r
KPKGVER=$KUPS-$ABI              # version of the .deb packages
