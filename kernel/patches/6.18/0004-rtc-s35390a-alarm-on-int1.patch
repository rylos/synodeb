diff --git a/drivers/rtc/rtc-s35390a.c b/drivers/rtc/rtc-s35390a.c
index 3408d2a..800b7dc 100644
--- a/drivers/rtc/rtc-s35390a.c
+++ b/drivers/rtc/rtc-s35390a.c
@@ -12,11 +12,13 @@
 #include <linux/bcd.h>
 #include <linux/slab.h>
 #include <linux/delay.h>
+#include <linux/property.h>
 
 #define S35390A_CMD_STATUS1	0
 #define S35390A_CMD_STATUS2	1
 #define S35390A_CMD_TIME1	2
 #define S35390A_CMD_TIME2	3
+#define S35390A_CMD_INT1_REG1	4
 #define S35390A_CMD_INT2_REG1	5
 
 #define S35390A_BYTE_YEAR	0
@@ -35,6 +37,7 @@
 #define S35390A_FLAG_POC	BIT(0)
 #define S35390A_FLAG_BLD	BIT(1)
 #define S35390A_FLAG_INT2	BIT(2)
+#define S35390A_FLAG_INT1	BIT(3)
 #define S35390A_FLAG_24H	BIT(6)
 #define S35390A_FLAG_RESET	BIT(7)
 
@@ -49,6 +52,10 @@
 #define S35390A_INT2_MODE_FREQ		BIT(3) /* INT2FE */
 #define S35390A_INT2_MODE_PMIN		(BIT(3) | BIT(2)) /* INT2FE | INT2ME */
 
+/* INT1 pin output mode (same layout, three bits higher) */
+#define S35390A_INT1_MODE_MASK		0xE0
+#define S35390A_INT1_MODE_ALARM		BIT(5) /* INT1AE */
+
 static const struct i2c_device_id s35390a_id[] = {
 	{ "s35390a" },
 	{ }
@@ -64,6 +71,13 @@ MODULE_DEVICE_TABLE(of, s35390a_of_match);
 struct s35390a {
 	struct i2c_client *client[8];
 	int twentyfourhour;
+	/*
+	 * Alarm on the INT1 pin instead of INT2 ("sii,alarm-int1"): boards such
+	 * as the Synology DS923+ wire INT1 to the power-on logic.
+	 */
+	bool int1;
+	u8 mode_mask, mode_alarm, flag_int;
+	int alarm_reg;
 };
 
 static int s35390a_set_reg(struct s35390a *s35390a, int reg, char *buf, int len)
@@ -292,7 +306,7 @@ static int s35390a_rtc_set_alarm(struct device *dev, struct rtc_wkalrm *alm)
 		return err;
 
 	if (alm->enabled)
-		sts = S35390A_INT2_MODE_ALARM;
+		sts = s35390a->mode_alarm;
 	else
 		sts = S35390A_INT2_MODE_NOINTR;
 
@@ -316,8 +330,7 @@ static int s35390a_rtc_set_alarm(struct device *dev, struct rtc_wkalrm *alm)
 	for (i = 0; i < 3; ++i)
 		buf[i] = bitrev8(buf[i]);
 
-	err = s35390a_set_reg(s35390a, S35390A_CMD_INT2_REG1, buf,
-								sizeof(buf));
+	err = s35390a_set_reg(s35390a, s35390a->alarm_reg, buf, sizeof(buf));
 
 	return err;
 }
@@ -333,7 +346,7 @@ static int s35390a_rtc_read_alarm(struct device *dev, struct rtc_wkalrm *alm)
 	if (err < 0)
 		return err;
 
-	if ((sts & S35390A_INT2_MODE_MASK) != S35390A_INT2_MODE_ALARM) {
+	if ((sts & s35390a->mode_mask) != s35390a->mode_alarm) {
 		/*
 		 * When the alarm isn't enabled, the register to configure
 		 * the alarm time isn't accessible.
@@ -344,7 +357,7 @@ static int s35390a_rtc_read_alarm(struct device *dev, struct rtc_wkalrm *alm)
 		alm->enabled = 1;
 	}
 
-	err = s35390a_get_reg(s35390a, S35390A_CMD_INT2_REG1, buf, sizeof(buf));
+	err = s35390a_get_reg(s35390a, s35390a->alarm_reg, buf, sizeof(buf));
 	if (err < 0)
 		return err;
 
@@ -435,6 +448,19 @@ static int s35390a_probe(struct i2c_client *client)
 	s35390a->client[0] = client;
 	i2c_set_clientdata(client, s35390a);
 
+	s35390a->int1 = device_property_read_bool(dev, "sii,alarm-int1");
+	if (s35390a->int1) {
+		s35390a->mode_mask = S35390A_INT1_MODE_MASK;
+		s35390a->mode_alarm = S35390A_INT1_MODE_ALARM;
+		s35390a->flag_int = S35390A_FLAG_INT1;
+		s35390a->alarm_reg = S35390A_CMD_INT1_REG1;
+	} else {
+		s35390a->mode_mask = S35390A_INT2_MODE_MASK;
+		s35390a->mode_alarm = S35390A_INT2_MODE_ALARM;
+		s35390a->flag_int = S35390A_FLAG_INT2;
+		s35390a->alarm_reg = S35390A_CMD_INT2_REG1;
+	}
+
 	/* This chip uses multiple addresses, use dummy devices for them */
 	for (i = 1; i < 8; ++i) {
 		s35390a->client[i] = devm_i2c_new_dummy_device(dev,
@@ -462,7 +488,7 @@ static int s35390a_probe(struct i2c_client *client)
 	else
 		s35390a->twentyfourhour = 0;
 
-	if (status1 & S35390A_FLAG_INT2) {
+	if (status1 & s35390a->flag_int) {
 		/* disable alarm (and maybe test mode) */
 		buf = 0;
 		err = s35390a_set_reg(s35390a, S35390A_CMD_STATUS2, &buf, 1);
@@ -487,7 +513,7 @@ static int s35390a_probe(struct i2c_client *client)
 	set_bit(RTC_FEATURE_ALARM_RES_MINUTE, rtc->features);
 	clear_bit(RTC_FEATURE_UPDATE_INTERRUPT, rtc->features);
 
-	if (status1 & S35390A_FLAG_INT2)
+	if (status1 & s35390a->flag_int)
 		rtc_update_irq(rtc, 1, RTC_AF);
 
 	return devm_rtc_register_device(rtc);
