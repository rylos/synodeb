+++ b/drivers/leds/Kconfig
@@ -107,6 +107,13 @@ config LEDS_ARIEL
 
 	  Say Y to if your machine is a Dell Wyse 3020 thin client.
 
+config LEDS_ATMEGA1608
+	tristate "LED support for the Synology ATmega1608 disk LED controller"
+	depends on LEDS_CLASS && I2C
+	help
+	  The ATmega1608 microcontroller that drives the green/orange disk
+	  LEDs of Synology NAS such as the DS923+ (I2C address 0x60).
+
 config LEDS_AW200XX
 	tristate "LED support for Awinic AW20036/AW20054/AW20072/AW20108"
 	depends on LEDS_CLASS
