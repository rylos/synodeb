diff --git a/drivers/ata/Kconfig b/drivers/ata/Kconfig
index 120a2b7..b57967e 100644
--- a/drivers/ata/Kconfig
+++ b/drivers/ata/Kconfig
@@ -67,6 +67,18 @@ config ATA_FORCE
 
 	  If unsure, say Y.
 
+config ATA_LEDS
+	bool "Per-port LED triggers"
+	depends on LEDS_TRIGGERS
+	help
+	  Register one LED trigger per ATA port, named after the port
+	  ("ata1", "ata2", ...), that blinks on every completed command.
+	  NAS front panels with one activity LED per bay (e.g. Synology)
+	  attach each bay LED to the trigger of its port. Attached LEDs
+	  stay on and blink off on activity.
+
+	  If unsure, say N.
+
 config ATA_ACPI
 	bool "ATA ACPI Support"
 	depends on ACPI
diff --git a/drivers/ata/libata-core.c b/drivers/ata/libata-core.c
index cd9c965..9c1283e 100644
--- a/drivers/ata/libata-core.c
+++ b/drivers/ata/libata-core.c
@@ -4987,6 +4987,10 @@ void ata_qc_complete(struct ata_queued_cmd *qc)
 
 	/* Trigger the LED (if available) */
 	ledtrig_disk_activity(!!(qc->tf.flags & ATA_TFLAG_WRITE));
+#ifdef CONFIG_ATA_LEDS
+	/* per-port trigger: attached LEDs stay on and blink off */
+	led_trigger_blink_oneshot(ap->ledtrig, 50, 50, 1);
+#endif
 
 	/*
 	 * In order to synchronize EH with the regular execution path, a qc that
@@ -5659,6 +5663,9 @@ void ata_port_free(struct ata_port *ap)
 	if (!ap)
 		return;
 
+#ifdef CONFIG_ATA_LEDS
+	led_trigger_unregister_simple(ap->ledtrig);
+#endif
 	kfree(ap->pmp_link);
 	kfree(ap->slave_link);
 	ida_free(&ata_ida, ap->print_id);
@@ -6079,6 +6086,20 @@ int ata_host_register(struct ata_host *host, const struct scsi_host_template *sh
 	if (rc)
 		goto err_tadd;
 
+#ifdef CONFIG_ATA_LEDS
+	for (i = 0; i < host->n_ports; i++) {
+		struct ata_port *ap = host->ports[i];
+
+		if (ata_port_is_dummy(ap) || ap->ledtrig)
+			continue;
+		snprintf(ap->ledtrig_name, sizeof(ap->ledtrig_name), "ata%u",
+			 ap->print_id);
+		led_trigger_register_simple(ap->ledtrig_name, &ap->ledtrig);
+		/* LEDs attached later start lit */
+		led_trigger_event(ap->ledtrig, LED_FULL);
+	}
+#endif
+
 	/* set cable, sata_spd_limit and report */
 	for (i = 0; i < host->n_ports; i++) {
 		struct ata_port *ap = host->ports[i];
