+/* ->error_handler(), unless the round is taken by a PMP vendor call */
+static inline void ata_eh_call_error_handler(struct ata_port *ap)
+{
+	if (!sata_pmp_vendor_eh(ap))
+		ap->ops->error_handler(ap);
+}
+
 #endif /* __LIBATA_H__ */
