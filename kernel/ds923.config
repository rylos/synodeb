# Synology DS923+ — fragment applied on top of the Debian config of the branch (build-kernel.sh adds the -<ABI>-ds923 kernel suffix)
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set
# Platform driver (kernel/src, kernel/patches): built-in, powers USB VBUS and the bays
# before the initramfs and registers the RTC before rtc_hctosys
CONFIG_SYNOLOGY_DS923=y
CONFIG_LEDS_ATMEGA1608=m
# Seiko S-35390A RTC on I2C bus AMDI0010 UID 3 (0x30): built-in, the only RTC = rtc0
# as in DSM; CMOS RTC stays a module and is blacklisted (pkg modprobe.d)
CONFIG_RTC_DRV_S35390A=y
CONFIG_RTC_DRV_CMOS=m
# pstore on EFI variables only on request (efi_pstore.pstore_disable=0):
# a panic loop must not fill the NVRAM holding the DOM boot entry
CONFIG_EFI_VARS_PSTORE_DEFAULT_DISABLE=y
# One LED trigger per ATA port ("ataN", patch 0005): green bay LED = activity of its disk
CONFIG_ATA_LEDS=y
# LED triggers used by the synohwd daemon
CONFIG_LEDS_TRIGGER_TIMER=m
CONFIG_LEDS_TRIGGER_PATTERN=m
# Platform hardware (already y/m in Debian, restated)
CONFIG_PINCTRL_AMD=y
CONFIG_SERIAL_8250_DW=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_SENSORS_DRIVETEMP=m
CONFIG_SENSORS_K10TEMP=m
CONFIG_AQTION=m
CONFIG_R8169=m
CONFIG_SATA_AHCI=m
CONFIG_BLK_DEV_NVME=m
CONFIG_NVME_HWMON=y
# Leaner build: no debuginfo (BTF depends on DEBUG_INFO)
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set
# Module signing key generated locally
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
# The Synology GRUB (2.02~beta3) does not verify the kernel: the chain is not measured,
# automatic lockdown would only block unsigned DKMS modules
# CONFIG_LOCK_DOWN_IN_EFI_SECURE_BOOT is not set
