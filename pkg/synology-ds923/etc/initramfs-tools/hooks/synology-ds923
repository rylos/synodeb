#!/bin/sh
# DS923+ initramfs (MODULES=dep, conf.d/synodeb.conf): kernel and initrd live on the DOM
# (synoboot2, 84 MB), so the initrd must stay small.
# synology_ds923 (bay power, USB VBUS) is built into the kernel and starts first; here:
#  - the drivers the root can be on even if mkinitramfs did not see them (SATA, NVMe, USB);
#  - USB storage + vfat/nls to reach the DOM (kernel trial, synodeb-trial);
#  - blkid/sed for the synodeb scripts, the module blacklist;
#  - a final cleanup of what other hooks add and the boot does not need.
# mkinitramfs runs the hooks in /etc/initramfs-tools/hooks after all those in
# /usr/share/initramfs-tools/hooks (udev, mdadm, lvm2, btrfs...): the cleanup sees them all.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac
. /usr/share/initramfs-tools/hook-functions

manual_add_modules xhci_pci xhci_hcd usb_storage uas sd_mod \
    ahci libahci nvme vfat nls_cp437 nls_ascii wdat_wdt
copy_exec /usr/sbin/blkid /sbin
copy_exec /usr/bin/sed /bin
# while installing, the kernel can be configured before dpkg has put this package's
# conffiles in place: without the file this is skipped (the trigger rebuilds it later)
if [ -f /etc/modprobe.d/synology-ds923.conf ]; then
    mkdir -p "$DESTDIR/etc/modprobe.d"
    cp /etc/modprobe.d/synology-ds923.conf "$DESTDIR/etc/modprobe.d/"
fi

# --- cleanup ---
# hwdb.bin (13 MB uncompressed, ~3 MB in the initrd): vendor/model names, keyboards,
# sensors; no boot rule for disks, md or dm needs it
rm -f "$DESTDIR/usr/lib/udev/hwdb.bin" "$DESTDIR/etc/udev/hwdb.bin"
# btrfs/xfs tools are needed in the initramfs only for a btrfs/xfs root
rootfs=$(awk '$1 !~ /^#/ && $2 == "/" { print $3 }' /etc/fstab 2>/dev/null)
if [ "$rootfs" != btrfs ]; then
    rm -f "$DESTDIR/usr/bin/btrfs" "$DESTDIR/usr/sbin/fsck.btrfs" "$DESTDIR/usr/sbin/btrfs" \
        "$DESTDIR/usr/lib/udev/rules.d/64-btrfs.rules" "$DESTDIR/usr/lib/udev/rules.d/64-btrfs-dm.rules" \
        "$DESTDIR/lib/udev/rules.d/64-btrfs.rules" "$DESTDIR/lib/udev/rules.d/64-btrfs-dm.rules" \
        "$DESTDIR/scripts/local-premount/btrfs"
fi
if [ "$rootfs" != xfs ]; then
    rm -f "$DESTDIR/usr/sbin/xfs_repair" "$DESTDIR/usr/sbin/fsck.xfs"
fi
rm -f "$DESTDIR/etc/mdadm/mdadm.conf.tmp"
# Without ARRAY lines in mdadm.conf the mdadm hook generates its own with mkconf, scanning
# every disk: the initramfs ("mdadm --assemble --scan") would then also assemble arrays of
# another system, such as DSM's, in read-write mode. The system file is used instead: the
# installer writes ARRAY lines for this system's arrays plus "AUTO -all".
if [ -d "$DESTDIR/etc/mdadm" ]; then
    # neither ARRAY lines nor "AUTO -all": every array found would be assembled
    grep -q -e '^[[:space:]]*ARRAY[[:space:]]' -e '^[[:space:]]*AUTO[[:space:]].*-all' /etc/mdadm/mdadm.conf 2>/dev/null ||
        echo "W: synodeb: /etc/mdadm/mdadm.conf has no ARRAY line: the initramfs may assemble the arrays of other systems (DSM) too" >&2
    [ ! -f /etc/mdadm/mdadm.conf ] || cp /etc/mdadm/mdadm.conf "$DESTDIR/etc/mdadm/mdadm.conf"
fi
exit 0
