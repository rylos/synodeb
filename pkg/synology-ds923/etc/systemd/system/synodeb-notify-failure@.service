[Unit]
Description=synodeb: notify the failure of %i
DefaultDependencies=no
Wants=network-online.target
After=network-online.target
# not while shutting down: without network the notification could not go out anyway and
# would only delay the shutdown
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'systemctl status --no-pager -l -n 15 "$1" 2>&1 | /usr/lib/synodeb/notify -p high "unit failed: $1" -' sh %i
TimeoutStartSec=2min
