// synodeb: automatic Debian updates (security and updates), no automatic reboot.
// The synodeb kernel and synology-ds923 come from the synodeb repository and are upgraded
// by hand ('apt upgrade', then a reboot): a kernel upgrade writes the Synology DOM.
// Log: /var/log/unattended-upgrades/.
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
APT::Periodic::AutocleanInterval "7";

// besides those of 50unattended-upgrades (Debian, Debian-Security): trixie-updates too
Unattended-Upgrade::Origins-Pattern {
        "origin=Debian,codename=${distro_codename}-updates";
};
// regular expressions on the package name
Unattended-Upgrade::Package-Blacklist {
        "linux-image-.*ds923(-longterm|-stable)?$";
        "linux-headers-.*ds923(-longterm|-stable)?$";
        "synology-ds923$";
};
Unattended-Upgrade::Automatic-Reboot "false";
Unattended-Upgrade::Remove-Unused-Kernel-Packages "false";
Unattended-Upgrade::Remove-Unused-Dependencies "false";
// an upgrade interrupted by a shutdown must not leave dpkg half-way
Unattended-Upgrade::MinimalSteps "true";
Unattended-Upgrade::InstallOnShutdown "false";
