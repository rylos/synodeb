#!/bin/sh
# Single synodeb notifier: smartd, mdadm, synohwd, failed units, boot completed.
#   /usr/lib/synodeb/notify [-p low|normal|high|urgent] [-f] TITLE [MESSAGE|-]
#     -p  priority (default normal); messages below MIN_PRIORITY are dropped
#     -f  send even if the same message went out recently (repeat suppression)
#     -   read the message from standard input
# Backends in /etc/synodeb/notify.conf: email (msmtp), Telegram, ntfy. With no backend
# configured it only writes to the journal. Exits 0 if at least one backend worked (or there
# are none), 1 if all configured ones failed: callers ignore it.
set -u
CONF=${SYNODEB_NOTIFY_CONF:-/etc/synodeb/notify.conf}
STATE=/run/synodeb/notify

prio=normal force=0
while getopts p:f o; do
    case $o in
    p) prio=$OPTARG ;;
    f) force=1 ;;
    *) sed -n '3,6p' "$0" >&2; exit 2 ;;
    esac
done
shift $((OPTIND - 1))
[ $# -ge 1 ] || { sed -n '3,6p' "$0" >&2; exit 2; }
# valid UTF-8 only (a cut multibyte character at the end is dropped): Telegram rejects the rest
utf8() { if command -v iconv >/dev/null; then iconv -c -f UTF-8 -t UTF-8 2>/dev/null; else cat; fi; }
# the title goes into a mail header: one line
title=$(printf '%s' "$1" | tr '\r\n\t' '   ' | head -c 200 | utf8)
msg=${2:-}
if [ "$msg" = - ]; then msg=$(head -c 3500 | utf8); else msg=$(printf '%s' "$msg" | head -c 3500 | utf8); fi

# a header value: RFC 2047 encoded-words if it is not plain ASCII
hdr() {
    if printf '%s' "$1" | LC_ALL=C grep -q '[^ -~]'; then
        python3 -I -c 'import sys; from email.header import Header; print(Header(sys.argv[1], "utf-8").encode())' "$1" 2>/dev/null ||
            printf '%s' "$1"
    else
        printf '%s' "$1"
    fi
}
# a double-quoted curl config value: secrets (tokens, URLs with a token) go to curl on
# stdin (-K -), not on its command line, which every user can read in /proc
cq() {
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\r/\\r/g' -e 's/\t/\\t/g' |
        awk 'NR > 1 { printf "\\n" } { printf "%s", $0 }'
}

rank() { case $1 in low) echo 1 ;; high) echo 3 ;; urgent) echo 4 ;; *) echo 2 ;; esac; }

# defaults (notify.conf overrides them)
MIN_PRIORITY=normal
REPEAT_MINUTES=30
EMAIL_TO='' EMAIL_FROM='' SMTP_HOST='' SMTP_PORT=587 SMTP_TLS=starttls
SMTP_USER='' SMTP_PASSWORD_FILE=''
TELEGRAM_TOKEN='' TELEGRAM_CHAT_ID=''
NTFY_URL='' NTFY_TOKEN=''
# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"

host=$(hostname 2>/dev/null || echo nas)
logger -t synodeb-notify -p "user.$(case $prio in low) echo info ;; normal) echo notice ;; high) echo warning ;; *) echo crit ;; esac)" \
    -- "[$prio] $title${msg:+: $msg}" 2>/dev/null || true
[ "$(rank "$prio")" -ge "$(rank "$MIN_PRIORITY")" ] || exit 0
[ -n "$EMAIL_TO$TELEGRAM_TOKEN$NTFY_URL" ] || exit 0

# repeat suppression: same title+message within REPEAT_MINUTES -> not sent again
mkdir -p "$STATE" 2>/dev/null
key=$(printf '%s\n%s' "$title" "$msg" | md5sum | cut -c1-16)
if [ "$force" = 0 ] && [ -n "$(find "$STATE/$key" -mmin "-$REPEAT_MINUTES" 2>/dev/null)" ]; then
    logger -t synodeb-notify -- "already sent in the last $REPEAT_MINUTES minutes: $title" 2>/dev/null || true
    exit 0
fi

subject="[$host] $title"
ok=0 tried=0

if [ -n "$EMAIL_TO" ] && [ -n "$SMTP_HOST" ]; then
    tried=1
    set -- --host="$SMTP_HOST" --port="$SMTP_PORT" --timeout=20 --from="${EMAIL_FROM:-root@$host}"
    case $SMTP_TLS in
    starttls) set -- "$@" --tls=on --tls-starttls=on ;;
    tls|smtps) set -- "$@" --tls=on --tls-starttls=off ;;
    *) set -- "$@" --tls=off ;;
    esac
    if [ -n "$SMTP_USER" ]; then
        set -- "$@" --auth=on --user="$SMTP_USER"
        [ -z "$SMTP_PASSWORD_FILE" ] || set -- "$@" --passwordeval="cat $SMTP_PASSWORD_FILE"
    fi
    # shellcheck disable=SC2086
    if printf 'From: %s\nTo: %s\nSubject: %s\nX-Priority: %s\nContent-Type: text/plain; charset=UTF-8\n\n%s\n\n-- \nsynodeb %s\n' \
        "${EMAIL_FROM:-root@$host}" "$EMAIL_TO" "$(hdr "$subject")" "$prio" "$msg" "$(date '+%F %T')" |
        msmtp "$@" -- $EMAIL_TO; then
        ok=1
    else
        logger -t synodeb-notify -- "email failed" 2>/dev/null || true
    fi
fi

if [ -n "$TELEGRAM_TOKEN" ] && [ -n "$TELEGRAM_CHAT_ID" ]; then
    tried=1
    if printf 'url = "%s"\n' "$(cq "https://api.telegram.org/bot$TELEGRAM_TOKEN/sendMessage")" |
        curl -K - -fsS --max-time 20 -o /dev/null \
        --data-urlencode "chat_id=$TELEGRAM_CHAT_ID" \
        --data-urlencode "text=$subject${msg:+
$msg}" \
        -d disable_notification="$([ "$(rank "$prio")" -le 1 ] && echo true || echo false)"; then
        ok=1
    else
        logger -t synodeb-notify -- "telegram failed" 2>/dev/null || true
    fi
fi

if [ -n "$NTFY_URL" ]; then
    tried=1
    np=$(case $prio in low) echo 2 ;; high) echo 4 ;; urgent) echo 5 ;; *) echo 3 ;; esac)
    # title and priority as URL parameters: HTTP headers do not handle UTF-8. The URL (the
    # topic name is the secret of a public server), the token and the message go in the config.
    if {
        printf 'url = "%s"\n' "$(cq "$NTFY_URL")"
        [ -z "$NTFY_TOKEN" ] || printf 'header = "%s"\n' "$(cq "Authorization: Bearer $NTFY_TOKEN")"
        printf 'data-raw = "%s"\n' "$(cq "${msg:-$title}")"
    } | curl -K - -fsS --max-time 20 -o /dev/null \
        --url-query "title=$subject" --url-query "priority=$np" --url-query "tags=synodeb"; then
        ok=1
    else
        logger -t synodeb-notify -- "ntfy failed" 2>/dev/null || true
    fi
fi

# touch, not ": >": a failed redirection of a special builtin would exit the shell
[ "$ok" = 0 ] || touch "$STATE/$key" 2>/dev/null || true
[ "$tried" = 0 ] || [ "$ok" = 1 ]
