#!/bin/sh
# Boot/shutdown notices (from synodeb-boot-ok.service):
#   boot-report start   boot confirmed: "boot completed" notification; high priority if
#                       the previous boot did not end with a clean shutdown
#                       (watchdog, panic, power failure) or if the watchdog reset the board
#   boot-report stop    clean shutdown: removes the marker
# Marker: /var/lib/synodeb/running (one write per boot).
set -u
MARK=/var/lib/synodeb/running
case "${1:-}" in
start)
    prio=normal
    why=''
    if [ -f "$MARK" ]; then
        prio=high
        why="The previous boot ($(cat "$MARK" 2>/dev/null)) did not end cleanly (watchdog, panic, hang or power failure)."
    fi
    for w in /sys/class/watchdog/watchdog*; do
        [ -r "$w/bootstatus" ] || continue
        bs=$(cat "$w/bootstatus" 2>/dev/null || echo 0)
        # WDIOF_CARDRESET (0x20): the last reset was done by the watchdog
        if [ $((bs & 32)) -ne 0 ]; then
            prio=high
            why="$why Watchdog $(cat "$w/identity" 2>/dev/null) reset the board."
        fi
    done
    mkdir -p "${MARK%/*}"
    { date '+%F %T'; } > "$MARK.tmp" && mv -f "$MARK.tmp" "$MARK"
    msg="$(uname -r), $(ip -br -4 addr show scope global 2>/dev/null | awk '{printf "%s %s; ", $1, $3}')"
    [ -z "$why" ] || msg="$why
$msg"
    /usr/lib/synodeb/notify -f -p "$prio" "boot completed" "$msg"
    ;;
stop)
    rm -f "$MARK"
    ;;
*) sed -n '2,8p' "$0" >&2; exit 2 ;;
esac
exit 0
