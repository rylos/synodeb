#!/bin/sh
# Boot/shutdown notices (from synodeb-boot-ok.service):
#   boot-report start   boot confirmed: "boot completed" notification; high priority if
#                       the previous boot did not end with a clean shutdown
#                       (watchdog, panic, power failure) or if the watchdog reset the board
#   boot-report stop    clean shutdown: removes the marker
# Marker: /var/lib/synodeb/running (one write per boot).
set -u
MARK=/var/lib/synodeb/running
case "${1:-}" in
start)
    prio=normal
    why=''
    if [ -f "$MARK" ]; then
        prio=high
        why="The previous boot ($(cat "$MARK" 2>/dev/null)) did not end cleanly (watchdog, panic, hang or power failure)."
    fi
    for w in /sys/class/watchdog/watchdog*; do
        [ -r "$w/bootstatus" ] || continue
        bs=$(cat "$w/bootstatus" 2>/dev/null || echo 0)
        # WDIOF_CARDRESET (0x20): the last reset was done by the watchdog
        if [ $((bs & 32)) -ne 0 ]; then
            prio=high
            why="$why Watchdog $(cat "$w/identity" 2>/dev/null) reset the board."
        fi
    done
    # a btrfs root mounted "degraded": by the initramfs because a device was missing
    # (scripts/local-premount/synodeb-degraded), or set by hand
    # Once all the devices are back, the one that was missing holds stale copies of what was
    # written meanwhile: a scrub rewrites them from the good device (in the background).
    WAS=/var/lib/synodeb/root-was-degraded
    if [ -e /run/synodeb/root-degraded ] || findmnt -n -o OPTIONS / 2>/dev/null | grep -q '\(^\|,\)degraded\(,\|$\)'; then
        prio=high
        why="$why The root filesystem is mounted degraded: a device is missing (btrfs filesystem show /). New data is written to the remaining device only: replace the drive (btrfs replace) as soon as possible."
        mkdir -p "${WAS%/*}"
        : > "$WAS"
    elif [ -e "$WAS" ] && [ "$(findmnt -n -o FSTYPE /)" = btrfs ]; then
        rm -f "$WAS"
        if btrfs scrub start / >/dev/null 2>&1; then
            why="$why The root filesystem has all its devices again after a degraded boot: a scrub was started to resync them (btrfs scrub status /)."
        else
            prio=high
            why="$why The root filesystem has all its devices again after a degraded boot, but 'btrfs scrub start /' failed: run it by hand."
        fi
    fi
    mkdir -p "${MARK%/*}"
    { date '+%F %T'; } > "$MARK.tmp" && mv -f "$MARK.tmp" "$MARK"
    why=${why# }
    msg="$(uname -r), $(ip -br -4 addr show scope global 2>/dev/null | awk '{printf "%s %s; ", $1, $3}')"
    [ -z "$why" ] || msg="$why
$msg"
    /usr/lib/synodeb/notify -f -s boot -p "$prio" "boot completed" "$msg"
    ;;
stop)
    rm -f "$MARK"
    ;;
*) sed -n '2,8p' "$0" >&2; exit 2 ;;
esac
exit 0
