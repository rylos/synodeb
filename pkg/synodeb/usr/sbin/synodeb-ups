#!/bin/sh
# synodeb-ups — UPS handling like DSM 7.4.1: when the battery runs low the NAS enters
# "Safe Mode" instead of powering off.
#
#   synodeb-ups setup [--keep-password] [--no-stop] [DRIVER]
#                                         NUT configuration (/etc/nut) from the templates in
#                                         /usr/share/synodeb/nut; random monuser password
#                                         (--keep-password: the one set); no USB UPS: NUT disabled
#     DRIVER: --driver NAME [--port PORT] [--opt NAME[=VALUE]]...  a NUT driver other than
#                                         usbhid-ups (kept in /etc/synodeb/ups-driver.conf for the
#                                         next setup; NUT is enabled even without a known USB UPS)
#             --default-driver            back to usbhid-ups on the first USB UPS
#   synodeb-ups probe --driver NAME [--port PORT] [--opt NAME[=VALUE]]... [--timeout S]
#                                         try a driver without configuring anything: on stdout
#                                         the UPS variables as upsc prints them (exit 0), or
#                                         exit 1 with the driver output on stderr; exit 3 while
#                                         the NUT driver runs (it holds the UPS)
#   synodeb-ups passwd                    ask for the monuser password (e.g. Home Assistant: the
#                                         same as DSM) and write it to upsd.users and upsmon.conf
#   synodeb-ups status [--json]           UPS, Safe Mode and driver (--json: one object, schema 1)
#   synodeb-ups test quick|deep|stop|result
#                                         UPS battery test (NUT user admin, local): start the
#                                         quick or deep test, stop it, show ups.test.result
#   synodeb-ups firewall                  nftables rules for upsd (synodeb-nut-firewall.service)
#   synodeb-ups netbind                   (postinst) bind nut-server to the firewall unit when
#                                         upsd listens on the network and the drop-in is missing
#   synodeb-ups admin-user                (postinst) add the NUT user admin of 'test' to an
#                                         upsd.users written by setup before 4.3
#   events (from upssched, CMDSCRIPT):     onbatt online lowbatt nocomm fsd waittimeup
#   safemode-shutdowncmd                   upsmon SHUTDOWNCMD (critical UPS: OB+LB, FSD,
#                                          OB and then unreachable)
#   safeloop                               inside synodeb-ups-safe.service
#
# Safe Mode (like DSM's UPS Safe Mode):
#   isolate synodeb-ups-safe.target: all services stop except NUT, synohwd (fans,
#   LEDs), network and ssh; data volumes are unmounted, / and /boot go read-only, SATA
#   disks to standby; then the status is read every 10 s: 2 OL readings in a row -> reboot.
#   The NAS NEVER powers off (no poweroff: the kernel does not send '1' to the microcontroller):
#   if the UPS runs out, power is lost, and when mains power returns the
#   microcontroller turns the NAS back on ('q', restore after power loss, sent by synohwd).
#
# Configuration: /etc/synodeb/ups.conf (DRYRUN, NOCOMM_SAFEMODE, SAFESHUTDOWN, UPS,
# NETWORK_CLIENTS, SAFEMODE_AFTER, PRE_SAFEMODE_TIMEOUT).
# SAFEMODE_AFTER=N: Safe Mode N seconds after the UPS went on battery (a systemd timer
# started at ONBATT, stopped at ONLINE), not only when the battery runs low.
# Hooks: the executables in /etc/synodeb/ups-pre-safemode.d (names of letters, digits, - and _,
# in order) run before the services are stopped, with the reason as $1 and all within
# PRE_SAFEMODE_TIMEOUT seconds (e.g. stop VMs and containers cleanly). Not run with DRYRUN=1. Without NETWORK_CLIENTS upsd only listens on localhost; with it upsd
# listens on the network and runs only while the nftables rules of synodeb-nut-firewall are
# loaded (BindsTo= in the drop-in written by setup): no firewall, no upsd.
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
CONF=${SYNODEB_UPS_CONF:-/etc/synodeb/ups.conf}
TPL=/usr/share/synodeb/nut
NOTIFY=/usr/lib/synodeb/notify
RUN=/run/synodeb-ups
SAFE=$RUN/safemode          # Safe Mode flag
ONB=$RUN/onbatt             # on-battery flag
TESTING=$RUN/testing        # battery test started by 'synodeb-ups test' (quick|deep)
REBOOTING=$RUN/rebooting
# upsmon POWERDOWNFLAG (critical UPS): if it exists at shutdown, the Debian hook
# /usr/lib/systemd/system-shutdown/nutshutdown powers the UPS off (upsdrvctl shutdown). DSM does
# not (ups_safeshutdown=no) and this model has no shutdown.return: always remove it.
KILLPOWER=/run/nut/killpower
NETBIND=/etc/systemd/system/nut-server.service.d/synodeb-network-clients.conf
DRIVER_CONF=/etc/synodeb/ups-driver.conf   # written by 'setup --driver': UPS_DRIVER, UPS_PORT, UPS_OPTIONS
NUTLIB=/usr/libexec/nut                     # the NUT drivers (/lib/nut before NUT 2.8.2)
[ -d $NUTLIB ] || NUTLIB=/lib/nut

UPS=ups@localhost
DRYRUN=0                    # 1: log what would be done, no isolate/umount/standby/reboot
NOCOMM_SAFEMODE=onbatt      # onbatt | always (DSM) | never
SAFESHUTDOWN=no             # yes: when the UPS is exhausted, ask it to power off (DSM ups_safeshutdown)
NETWORK_CLIENTS=            # IPs allowed on upsd (port 3493), e.g. Home Assistant or another NAS
SAFEMODE_AFTER=0            # >0: Safe Mode after this many seconds on battery (DSM "after N minutes")
PRE_SAFEMODE_TIMEOUT=120    # seconds for all the hooks in $HOOKS together
HOOKS=/etc/synodeb/ups-pre-safemode.d
LOOP_SECONDS=10
# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"
UPS_DRIVER='' UPS_PORT=auto UPS_OPTIONS=''
# shellcheck source=/dev/null
[ -r "$DRIVER_CONF" ] && . "$DRIVER_CONF"

mkdir -p $RUN
log() { logger -p daemon.warning -t synodeb-ups -- "$*" 2>/dev/null || echo "synodeb-ups: $*" >&2; }
notify() { [ -x $NOTIFY ] && $NOTIFY -s ups "$@" >/dev/null 2>&1 || true; }
run() {
    if [ "$DRYRUN" = 1 ]; then log "DRYRUN: $*"; else "$@"; fi
}
# OL, OB (with or without LB) or ERR (upsd/driver unreachable, stale data)
status() {
    s=$(upsc "$UPS" ups.status 2>/dev/null) || { echo ERR; return; }
    case " $s " in
    *" OB "*) echo OB ;;
    *" OL "*) echo OL ;;
    *) echo ERR ;;
    esac
}
var() { upsc "$UPS" "$1" 2>/dev/null; }
fsd() { case " $(var ups.status) " in *" FSD "*) return 0 ;; esac; return 1; }  # forced shutdown
statelog() {
    log "$1: status=$(var ups.status) charge=$(var battery.charge)% runtime=$(var battery.runtime)s load=$(var ups.load)%"
}

# the executables in $HOOKS, in order, all within PRE_SAFEMODE_TIMEOUT seconds; never fails
pre_safemode_hooks() { # $1 = reason
    hooks=
    for h in "$HOOKS"/*; do
        [ -f "$h" ] && [ -x "$h" ] || continue
        case ${h##*/} in *[!A-Za-z0-9_-]*) continue ;; esac
        hooks="$hooks $h"
    done
    [ -n "$hooks" ] || return 0
    if [ "$DRYRUN" = 1 ]; then
        log "DRYRUN: hooks not run:$hooks"
        return 0
    fi
    log "running the pre-Safe Mode hooks (at most $PRE_SAFEMODE_TIMEOUT s):$hooks"
    # shellcheck disable=SC2086
    # shellcheck disable=SC2016  # the inner script expands its own arguments
    timeout -k 5 "$PRE_SAFEMODE_TIMEOUT" sh -c '
        r=$1; shift
        for h in "$@"; do
            if "$h" "$r" </dev/null 2>&1 | logger -t synodeb-ups-hook; then :; fi
        done' sh "$1" $hooks || log "pre-Safe Mode hooks: timeout or error (exit $?), going on"
    return 0
}
# SAFEMODE_AFTER: a timer started when the UPS goes on battery
start_wait_timer() {
    [ "${SAFEMODE_AFTER:-0}" -gt 0 ] 2>/dev/null || return 0
    wait_timer "$SAFEMODE_AFTER" && log "Safe Mode in $SAFEMODE_AFTER s unless power returns (SAFEMODE_AFTER)"
}
wait_timer() { # seconds; a new unit each time (the elapsed one may still exist)
    systemd-run --unit="synodeb-ups-wait-$(date +%s%N)" --on-active="${1}s" --timer-property=AccuracySec=1s \
        /usr/sbin/synodeb-ups waittimeup >/dev/null 2>&1
}
stop_wait_timer() { systemctl stop 'synodeb-ups-wait*.timer' >/dev/null 2>&1 || true; }
# a battery test started here is running: the UPS may report OB until it ends (cleared at
# ONLINE; at most 10 min for the quick test, 3 h for the deep one)
testing() {
    [ -f $TESTING ] || return 1
    case $(cat $TESTING 2>/dev/null) in deep) max=10800 ;; *) max=600 ;; esac
    [ $(($(date +%s) - $(date -r $TESTING +%s))) -lt $max ] && return 0
    rm -f $TESTING
    return 1
}

safemode() { # $1 = reason
    rm -f $KILLPOWER
    [ -f $SAFE ] && return 0
    case "$(systemctl is-system-running 2>/dev/null)" in
    stopping) log "system already shutting down: ignoring ($1)"; return 0 ;;
    esac
    # like DSM: if boot is still in progress, wait (max 5 minutes)
    i=0
    while [ "$(systemctl is-system-running 2>/dev/null)" = starting ] && [ $i -lt 150 ]; do
        sleep 2; i=$((i + 1))
    done
    # FSD (forced shutdown, e.g. "OL FSD" after 'upsmon -c fsd'): Safe Mode even on mains power
    if [ "$(status)" = OL ] && ! fsd; then
        log "UPS back online: no Safe Mode ($1)"
        return 0
    fi
    echo "$1 $(date '+%F %T')" > $SAFE
    log "Safe Mode ($1): stopping services and unmounting volumes; the NAS stays on"
    ch=$(var battery.charge) rt=$(var battery.runtime)
    notify -f -p urgent -e ups_safe_mode -v "reason=$1" -v "battery=$ch" -v "runtime=$rt" \
        "UPS: Safe Mode" "reason $1, battery $ch%, runtime $rt s. Services stopped, volumes unmounted; reboot when power returns."
    stop_wait_timer
    pre_safemode_hooks "$1"
    if [ "$DRYRUN" = 1 ]; then
        log "DRYRUN: systemctl isolate synodeb-ups-safe.target (starting only synodeb-ups-safe.service)"
        systemctl --no-block start synodeb-ups-safe.service
    else
        systemctl --no-block isolate synodeb-ups-safe.target
    fi
}

reboot_now() { # $1 = reason
    [ -f $REBOOTING ] && return 0
    : > $REBOOTING
    rm -f $KILLPOWER
    log "power restored ($1): reboot"
    notify -f -p high -e ups_power_restored_reboot "UPS: power restored" "leaving Safe Mode with a reboot"
    sleep 3
    if [ "$DRYRUN" = 1 ]; then
        log "DRYRUN: systemctl reboot"
        rm -f $SAFE $REBOOTING $ONB         # the test can be repeated
    else
        systemctl reboot
    fi
}

data_mounts() { # mount points on block devices except / and /boot, innermost first
    findmnt -rn -o TARGET,SOURCE | awk '$2 ~ /^\/dev\// && $1 != "/" && $1 != "/boot" { print $1 }' | sort -r
}

safeloop() {
    # isolate: wait for the services to stop (the stop jobs are not ordered against this one)
    i=0
    while [ $i -lt 120 ] && systemctl list-jobs --no-legend 2>/dev/null | grep -qv 'synodeb-ups-safe'; do
        sleep 1; i=$((i + 1))
    done
    log "Safe Mode: services stopped; unmounting data volumes"
    sync
    if grep -q ' /mnt/dsm/' /proc/mounts && command -v synodeb-dsm >/dev/null; then
        run synodeb-dsm umount
    fi
    for m in $(data_mounts); do
        run umount "$m" || { log "umount $m failed: remounting read-only"; run mount -o remount,ro "$m"; }
    done
    sync
    for m in /boot /; do
        mountpoint -q $m && { run mount -o remount,ro $m || log "remount ro of $m failed"; }
    done
    # SATA disks to standby (like DSM); not USB disks
    for b in /sys/block/sd*; do
        [ -e "$b" ] || continue
        case "$(readlink -f "$b/device")" in
        */ata[0-9]*) run hdparm -y "/dev/${b##*/}" >/dev/null 2>&1 ;;
        esac
    done
    log "Safe Mode active: checking the UPS every $LOOP_SECONDS s"
    ol=0 exhausted=0
    while :; do
        sleep "$LOOP_SECONDS"
        if [ "$(status)" = OL ]; then
            ol=$((ol + 1))
            [ $ol -lt 2 ] || { reboot_now "2 OL readings"; [ "$DRYRUN" = 1 ] && return 0; }
        else
            ol=0
            exhausted=$((exhausted + 1))
            if [ $exhausted = 2 ]; then
                log "waiting for the UPS to run out (the NAS powers back on when mains power returns)"
                if [ "$SAFESHUTDOWN" = yes ]; then
                    for _ in 1 2 3; do run upsdrvctl shutdown && break; sleep 40; done
                fi
            fi
        fi
    done
}

online() { # like DSM, on power restore
    stop_wait_timer
    if [ -f $ONB ]; then
        rm -f $ONB
        if testing; then
            log "UPS back online: end of the battery test ($(var ups.test.result))"
        elif [ ! -f $SAFE ]; then
            log "UPS back online, no Safe Mode"; ch=$(var battery.charge)
            notify -p normal -e ups_power_restored -v "battery=$ch" "UPS: power restored" "battery $ch%"
        fi
    fi
    rm -f $TESTING
    [ -f $SAFE ] || return 0
    # in Safe Mode: confirm with a second reading (like the loop) and reboot
    sleep "$LOOP_SECONDS"
    [ "$(status)" = OL ] && [ -f $SAFE ] && reboot_now "ONLINE event"
    return 0
}

subst_password() { # $1 = monuser password; writes upsd.users and upsmon.conf from the templates
    umask 027
    apw=$(admin_password)
    case $apw in ''|__ADMIN_PASSWORD__) apw=$(randpw) ;; esac
    for f in upsd.users upsmon.conf; do
        python3 -I -c 'import sys; t=open(sys.argv[1]).read(); open(sys.argv[2],"w").write(t.replace("__PASSWORD__", sys.argv[3]).replace("__ADMIN_PASSWORD__", sys.argv[4]))' \
            "$TPL/$f" "/etc/nut/$f.new" "$1" "$apw"
        chown root:nut "/etc/nut/$f.new" 2>/dev/null || true
        chmod 640 "/etc/nut/$f.new"
        mv "/etc/nut/$f.new" "/etc/nut/$f"
    done
}

current_password() { user_password monuser; }
admin_password() { user_password admin; }
user_password() { # password of [$1] in upsd.users
    awk -v u="[$1]" '$1 ~ /^\[/ { in_u = ($1 == u); next }
        in_u && $1 == "password" && $2 == "=" { print $3; exit }' /etc/nut/upsd.users 2>/dev/null
}
randpw() { head -c 18 /dev/urandom | base64 | tr -d '/+='; }

# the battery test, through upsd as the local NUT user admin (the password never on a command
# line: upscmd would show it in ps)
test_cmd() {
    case ${1:-} in
    quick) c=test.battery.start.quick ;;
    deep) c=test.battery.start.deep ;;
    stop) c=test.battery.stop ;;
    result) echo "${UPS%@*}: $(var ups.test.result || echo 'no ups.test.result')"; return 0 ;;
    *) echo "usage: synodeb-ups test quick|deep|stop|result" >&2; return 2 ;;
    esac
    [ "$(id -u)" = 0 ] || { echo "synodeb-ups: must run as root (sudo synodeb-ups test $1)" >&2; return 1; }
    pw=$(admin_password)
    case $pw in ''|__ADMIN_PASSWORD__)
        echo "synodeb-ups: no NUT user admin in /etc/nut/upsd.users: run 'sudo synodeb-ups setup --keep-password'" >&2
        return 1 ;;
    esac
    upscmd -l "$UPS" 2>/dev/null | grep -q "^$c " || { echo "synodeb-ups: the UPS does not support $c" >&2; return 1; }
    if [ "$1" != stop ]; then
        [ "$(status)" = OL ] || { echo "synodeb-ups: the UPS is not on mains power: no battery test" >&2; return 1; }
        echo "$1" > $TESTING
    fi
    log "battery test: $c"
    if ! out=$(PW=$pw python3 -I - "$UPS" "$c" <<'EOT'
import os, socket, sys
ups, host = (sys.argv[1].split("@") + ["localhost"])[:2]
host, _, port = host.partition(":")
s = socket.create_connection((host, int(port or 3493)), timeout=10)
f = s.makefile("rw", newline="\n")
for line in ("USERNAME admin", "PASSWORD " + os.environ["PW"], "INSTCMD %s %s" % (ups, sys.argv[2])):
    f.write(line + "\n"); f.flush()
    r = f.readline().strip()
    if not r.startswith("OK"):
        print("%s: %s" % (line.split()[0], r)); sys.exit(1)
f.write("LOGOUT\n"); f.flush()
print(r)
EOT
    ); then
        rm -f $TESTING
        echo "synodeb-ups: $c refused by upsd: $out" >&2
        return 1
    fi
    [ "$1" != stop ] || rm -f $TESTING
    echo "$c: $out"
}

# --driver/--port/--opt: checked into drv, port, opts (space separated NAME or NAME=VALUE), or
# exit 2. Only characters that need no quoting in ups.conf and on a command line.
drv='' port=auto opts='' nopts=0
driver_arg() { # option value
    case $1 in
    --driver)
        case $2 in ''|*[!a-z0-9_-]*) echo "synodeb-ups: invalid driver name: $2" >&2; exit 2 ;; esac
        [ -x "$NUTLIB/$2" ] || { echo "synodeb-ups: no NUT driver $NUTLIB/$2 (see /usr/share/nut/driver.list)" >&2; exit 2; }
        drv=$2 ;;
    --port)
        case $2 in ''|*[!A-Za-z0-9._:/@-]*) echo "synodeb-ups: invalid port: $2" >&2; exit 2 ;; esac
        port=$2 ;;
    --opt)
        n=${2%%=*}
        case $n in [a-z]*) ;; *) n=- ;; esac
        case $n in *[!a-z0-9_.]*) echo "synodeb-ups: invalid option name: $2" >&2; exit 2 ;; esac
        [ ${#n} -le 32 ] || { echo "synodeb-ups: option name too long: $n" >&2; exit 2; }
        case $n in driver|port|desc) echo "synodeb-ups: $n is not an option (--driver, --port)" >&2; exit 2 ;; esac
        if [ "$n" != "$2" ]; then
            case ${2#*=} in ''|*[!A-Za-z0-9._:/@+,=-]*) echo "synodeb-ups: invalid option value: $2" >&2; exit 2 ;; esac
        fi
        [ $nopts -lt 32 ] || { echo "synodeb-ups: more than 32 options" >&2; exit 2; }
        opts="${opts:+$opts }$2" nopts=$((nopts + 1)) ;;
    esac
}
# the [ups] section of ups.conf with this driver, port and options
driver_section() { # file
    awk -v d="$UPS_DRIVER" -v p="$UPS_PORT" -v o="$UPS_OPTIONS" '
        /^\[ups\]/ { s = 1 }
        s && $1 == "driver" { print "\tdriver = " d; next }
        s && $1 == "port" {
            print "\tport = " p
            n = split(o, a, " ")
            for (i = 1; i <= n; i++) {
                k = a[i]; v = ""
                if (index(k, "=")) { v = substr(k, index(k, "=") + 1); k = substr(k, 1, index(k, "=") - 1) }
                print (v == "" && index(a[i], "=") == 0) ? "\t" k : "\t" k " = \"" v "\""
            }
            next
        }
        { print }' "$1" > "$1.new" && mv -f "$1.new" "$1"
}

setup() {
    keep='' nostop='' setdrv=''
    usage="usage: synodeb-ups setup [--keep-password] [--no-stop] [--driver NAME [--port PORT] [--opt NAME[=VALUE]]... | --default-driver]"
    while [ $# -gt 0 ]; do
        case $1 in
        --keep-password) keep=1 ;;
        --no-stop) nostop=1 ;;
        --default-driver) setdrv=default ;;
        --driver|--port|--opt)
            [ $# -ge 2 ] || { echo "$usage" >&2; exit 2; }
            driver_arg "$1" "$2"; shift
            [ "$setdrv" = default ] || setdrv=custom ;;
        *) echo "$usage" >&2; exit 2 ;;
        esac
        shift
    done
    if [ "$setdrv" = custom ] && [ -z "$drv" ]; then echo "synodeb-ups: --port and --opt need --driver" >&2; exit 2; fi
    if [ "$setdrv" = default ] && [ -n "$drv$opts" ]; then echo "$usage" >&2; exit 2; fi
    [ -d /etc/nut ] || { echo "/etc/nut missing: install nut-server and nut-client" >&2; exit 1; }
    cl=$(clients) || exit 1
    if [ -n "$cl" ] && ! command -v nft >/dev/null; then
        echo "synodeb-ups: NETWORK_CLIENTS needs nftables (apt install nftables): /etc/nut not changed" >&2
        exit 1
    fi
    pw=
    [ -z "$keep" ] || pw=$(current_password)
    case $pw in ''|__PASSWORD__) pw=$(randpw) ;; esac
    [ -f /etc/nut/.synodeb-orig.tar ] || tar -C /etc/nut -cf /etc/nut/.synodeb-orig.tar . 2>/dev/null || true
    case $setdrv in
    custom)
        UPS_DRIVER=$drv UPS_PORT=$port UPS_OPTIONS=$opts
        mkdir -p "${DRIVER_CONF%/*}"
        printf '%s\n' "# written by 'synodeb-ups setup --driver' ('synodeb-ups setup --default-driver' removes it)" \
            "UPS_DRIVER=$UPS_DRIVER" "UPS_PORT=$UPS_PORT" "UPS_OPTIONS='$UPS_OPTIONS'" > "$DRIVER_CONF.new" &&
            mv -f "$DRIVER_CONF.new" "$DRIVER_CONF" ;;
    default)
        rm -f "$DRIVER_CONF"
        UPS_DRIVER='' UPS_PORT=auto UPS_OPTIONS='' ;;
    esac
    old=$(cat /etc/nut/ups.conf 2>/dev/null)
    for f in nut.conf ups.conf upsd.conf upssched.conf; do
        install -m 640 -o root -g nut "$TPL/$f" "/etc/nut/$f" 2>/dev/null || install -m 640 "$TPL/$f" "/etc/nut/$f"
    done
    if [ -n "$UPS_DRIVER" ]; then
        driver_section /etc/nut/ups.conf
        chown root:nut /etc/nut/ups.conf 2>/dev/null || true
        chmod 640 /etc/nut/ups.conf
    fi
    subst_password "$pw"
    # network clients (NETWORK_CLIENTS): upsd listens on all addresses, nftables does the
    # filtering, and nut-server is bound to the firewall unit (fail closed)
    if [ -n "$cl" ]; then
        printf '%s\n' 'LISTEN 0.0.0.0 3493' 'LISTEN :: 3493' >> /etc/nut/upsd.conf
        netbind
    else
        rm -f "$NETBIND"
    fi
    [ ! -d /run/systemd/system ] || systemctl daemon-reload || true
    echo "NUT configuration installed in /etc/nut (originals in /etc/nut/.synodeb-orig.tar)"
    if u=$(usb_ups) || [ -n "$UPS_DRIVER" ]; then
        now=
        [ ! -d /run/systemd/system ] || now=--now
        systemctl enable $now nut.target nut-driver.target nut-server.service nut-monitor.service \
            synodeb-nut-firewall.service >/dev/null 2>&1 || true
        if [ -n "$UPS_DRIVER" ]; then
            echo "UPS driver $UPS_DRIVER, port $UPS_PORT${UPS_OPTIONS:+, options $UPS_OPTIONS} ($DRIVER_CONF): NUT enabled"
        else
            echo "USB UPS found ($u): NUT enabled"
        fi
        if [ -d /run/systemd/system ]; then
            # a changed ups.conf takes effect when the driver starts again
            if [ "$old" != "$(cat /etc/nut/ups.conf)" ]; then
                systemctl restart nut-driver-enumerator.service >/dev/null 2>&1 || true
                systemctl restart nut-driver@ups.service >/dev/null 2>&1 ||
                    echo "synodeb-ups: the NUT driver did not start: journalctl -u nut-driver@ups" >&2
            fi
            # upsd reads upsd.users only at start or reload
            systemctl try-reload-or-restart nut-server.service >/dev/null 2>&1 || true
        fi
        echo "monuser password: for network clients set it with 'synodeb-ups passwd'"
    else
        # without a UPS the NUT driver would fail and restart forever (and notify each time)
        systemctl disable nut.target nut-driver.target nut-server.service nut-monitor.service \
            nut-driver-enumerator.path nut-driver-enumerator.service >/dev/null 2>&1 || true
        [ -n "$nostop" ] || [ ! -d /run/systemd/system ] || systemctl stop nut.target nut-driver.target 'nut-driver@*' \
            nut-server.service nut-monitor.service >/dev/null 2>&1 || true
        echo "no USB UPS connected: NUT stays off; connect the UPS and run 'synodeb-ups setup --keep-password'"
    fi
}

probe_cmd() {
    t=45
    usage="usage: synodeb-ups probe --driver NAME [--port PORT] [--opt NAME[=VALUE]]... [--timeout S]"
    while [ $# -gt 0 ]; do
        case $1 in
        --driver|--port|--opt) [ $# -ge 2 ] || { echo "$usage" >&2; exit 2; }; driver_arg "$1" "$2"; shift ;;
        --timeout)
            case ${2:-} in ''|*[!0-9]*) echo "$usage" >&2; exit 2 ;; esac
            t=$2; shift ;;
        *) echo "$usage" >&2; exit 2 ;;
        esac
        shift
    done
    [ -n "$drv" ] || { echo "$usage" >&2; exit 2; }
    [ "$(id -u)" = 0 ] || { echo "synodeb-ups: probe needs root" >&2; exit 1; }
    if systemctl -q is-active 'nut-driver@*.service' 2>/dev/null; then
        echo "synodeb-ups: a NUT driver is running and may hold the UPS: systemctl stop nut-driver.target first" >&2
        exit 3
    fi
    set -- -s synodeb-probe -x "port=$port"
    for o in $opts; do set -- "$@" -x "$o"; done
    # -d 1: the variables after the first update, then exit
    out=$(cd / && timeout -k 5 "$t" "$NUTLIB/$drv" "$@" -d 1 2>&1)
    data=$(printf '%s\n' "$out" | grep -E '^[a-z][a-z0-9_.]*: ')
    if printf '%s\n' "$data" | grep -q '^ups\.status: '; then
        printf '%s\n' "$data"
        exit 0
    fi
    printf '%s\n' "$out" | tail -n 20 >&2
    exit 1
}

# vendor:product of a connected USB UPS known to NUT (its udev rules list them), or failure
usb_ups() {
    rules=$(ls /usr/lib/udev/rules.d/*nut-usbups.rules /lib/udev/rules.d/*nut-usbups.rules 2>/dev/null | head -n 1)
    [ -n "$rules" ] || return 1
    for d in /sys/bus/usb/devices/*; do
        [ -r "$d/idVendor" ] || continue
        v=$(cat "$d/idVendor"); pr=$(cat "$d/idProduct")
        if grep -q "ATTR{idVendor}==\"$v\", ATTR{idProduct}==\"$pr\"" "$rules"; then
            echo "$v:$pr"
            return 0
        fi
    done
    return 1
}

# NETWORK_CLIENTS checked: "4 ADDRESS" / "6 ADDRESS" lines (an address or a network),
# failure with a message for anything else
clients() {
    set -f
    # shellcheck disable=SC2086
    python3 -I -c '
import ipaddress, sys
for a in sys.argv[1:]:
    try:
        n = ipaddress.ip_network(a, strict=False)
    except ValueError:
        sys.exit("synodeb-ups: invalid address in NETWORK_CLIENTS: " + a)
    print(n.version, n.network_address if n.num_addresses == 1 else n)
' $NETWORK_CLIENTS
    r=$?
    set +f
    return $r
}
# upsd.conf has a LISTEN on an address other than localhost
listens_network() {
    awk '$1 == "LISTEN" && $2 != "127.0.0.1" && $2 != "::1" && $2 != "localhost" { f = 1 } END { exit !f }' \
        /etc/nut/upsd.conf 2>/dev/null
}
# nut-server bound to the firewall unit: no nftables rules, no upsd (fail closed)
netbind() {
    mkdir -p "${NETBIND%/*}"
    printf '%s\n' "# written by 'synodeb-ups setup' (NETWORK_CLIENTS in $CONF): upsd listens on" \
        "# the network, so it runs only while the nftables rules of synodeb-nut-firewall are loaded" \
        '[Unit]' 'BindsTo=synodeb-nut-firewall.service' 'After=synodeb-nut-firewall.service' > "$NETBIND"
}

# nftables rules: upsd (3493) only from localhost and NETWORK_CLIENTS. Separate table,
# does not touch Docker's rules or /etc/nftables.conf. Fails (and upsd, bound to this
# unit with NETWORK_CLIENTS, does not run) on an invalid NETWORK_CLIENTS or without nft
# while upsd listens on the network; upsd on localhost only and no nft: nothing to filter.
firewall() {
    cl=$(clients) || return 1
    if ! command -v nft >/dev/null; then
        if [ -n "$cl" ] || listens_network; then
            echo "synodeb-ups: nft missing (apt install nftables): upsd must not listen on the network unfiltered" >&2
            return 1
        fi
        return 0
    fi
    v4=127.0.0.1 v6=::1
    while read -r fam ip; do
        case $fam in 6) v6="$v6, $ip" ;; 4) v4="$v4, $ip" ;; esac
    done <<EOT
$cl
EOT
    nft -f - <<EOT
table inet synodeb_nut
delete table inet synodeb_nut
table inet synodeb_nut {
	chain input {
		type filter hook input priority filter - 10; policy accept;
		tcp dport 3493 ip saddr { $v4 } accept
		tcp dport 3493 ip6 saddr { $v6 } accept
		tcp dport 3493 drop
	}
}
EOT
}

passwd_cmd() {
    printf 'monuser password (the same as the network clients, e.g. the one used under DSM): ' >&2
    stty -echo 2>/dev/null; read -r pw; stty echo 2>/dev/null; echo >&2
    [ -n "$pw" ] || { echo "empty password" >&2; exit 1; }
    # upsd.users / upsmon.conf: '#' starts a comment, a backslash escapes, blanks split
    case $pw in *[[:space:]\"\\#]*) echo "spaces, quotes, '#' and backslashes not allowed" >&2; exit 1 ;; esac
    subst_password "$pw"
    systemctl try-restart nut-server.service nut-monitor.service || true
    echo "password updated in /etc/nut/upsd.users and /etc/nut/upsmon.conf"
}

case "${1:-}" in
setup) shift; setup "$@"; exit 0 ;;
probe) shift; probe_cmd "$@" ;;
passwd) passwd_cmd; exit 0 ;;
test) shift; test_cmd "$@"; exit $? ;;
firewall) firewall; exit $? ;;
netbind)    # postinst: a configuration from before the binding (3.1) that listens on the network
    if [ ! -f "$NETBIND" ] && grep -q '^# synodeb' /etc/nut/upsmon.conf 2>/dev/null && listens_network; then
        netbind; echo "synodeb-ups: nut-server now bound to synodeb-nut-firewall ($NETBIND)"
    fi
    exit 0 ;;
admin-user) # postinst: a configuration from before 4.3, written by setup, without the user admin
    if grep -q '^# synodeb' /etc/nut/upsd.users 2>/dev/null && ! grep -q '^\[admin\]' /etc/nut/upsd.users; then
        umask 027
        { cat /etc/nut/upsd.users; echo
          sed -n '/^# Local only/,$p' "$TPL/upsd.users" | sed "s/__ADMIN_PASSWORD__/$(randpw)/"
        } > /etc/nut/upsd.users.new
        chown root:nut /etc/nut/upsd.users.new 2>/dev/null || true
        chmod 640 /etc/nut/upsd.users.new
        mv /etc/nut/upsd.users.new /etc/nut/upsd.users
        [ ! -d /run/systemd/system ] || systemctl try-reload-or-restart nut-server.service >/dev/null 2>&1 || true
        echo "synodeb-ups: NUT user admin added to /etc/nut/upsd.users (battery test)"
    fi
    exit 0 ;;
status)
    if [ "${2:-}" = --json ]; then
        # shellcheck disable=SC2016  # python reads the environment
        S_STATUS=$(var ups.status) S_READ=$(status) S_CHARGE=$(var battery.charge) \
        S_RUNTIME=$(var battery.runtime) S_LOAD=$(var ups.load) \
        S_SAFE=$( [ -f $SAFE ] && cat $SAFE) S_SAFEON=$( [ -f $SAFE ] && echo 1) \
        S_ONB=$( [ -f $ONB ] && date -r $ONB '+%F %T') S_TESTING=$(testing && cat $TESTING) \
        S_UPS=$UPS S_DRYRUN=$DRYRUN S_DRIVER=$UPS_DRIVER S_PORT=$UPS_PORT S_OPTIONS=$UPS_OPTIONS \
        S_CONF=$DRIVER_CONF python3 -I -c '
import json, os
e = os.environ.get
def num(v):
    try:
        return float(v) if "." in v else int(v)
    except (TypeError, ValueError):
        return None
custom = bool(e("S_DRIVER"))
safe = e("S_SAFE", "").split()
print(json.dumps({
    "schema": 1,
    "ups": e("S_UPS"),
    "status": e("S_STATUS") or None,
    "read": e("S_READ"),
    "battery_charge": num(e("S_CHARGE")),
    "battery_runtime": num(e("S_RUNTIME")),
    "load": num(e("S_LOAD")),
    "safe_mode": {"active": bool(e("S_SAFEON")), "reason": safe[0] if safe else None,
                  "since": " ".join(safe[1:]) or None},
    "on_battery_since": e("S_ONB") or None,
    "battery_test": e("S_TESTING") or None,
    "dryrun": e("S_DRYRUN") == "1",
    "driver": {"name": e("S_DRIVER") if custom else "usbhid-ups",
               "port": e("S_PORT") if custom else "auto",
               "options": e("S_OPTIONS", "").split() if custom else [],
               "default": not custom,
               "conf": e("S_CONF") if custom else None},
}))'
        exit $?
    fi
    echo "UPS $UPS: $(var ups.status) (read: $(status)), battery $(var battery.charge)%, runtime $(var battery.runtime) s, load $(var ups.load)%"
    if [ -f $SAFE ]; then echo "Safe Mode: active ($(cat $SAFE))"; else echo "Safe Mode: no"; fi
    [ -f $ONB ] && echo "on battery since $(date -r $ONB '+%F %T')"
    [ "$DRYRUN" = 1 ] && echo "DRYRUN=1 in $CONF: Safe Mode is only simulated"
    if [ -n "$UPS_DRIVER" ]; then
        echo "driver: $UPS_DRIVER, port $UPS_PORT${UPS_OPTIONS:+, options $UPS_OPTIONS} ($DRIVER_CONF)"
    else
        echo "driver: usbhid-ups on the first USB UPS (default)"
    fi
    exit 0 ;;
safeloop) safeloop; exit 0 ;;
esac

# events: one at a time (like DSM)
exec 9>$RUN/lock
flock -x 9
case "${1:-}" in
onbatt)
    statelog onbatt
    if [ ! -f $ONB ]; then
        : > $ONB
        if testing; then
            log "UPS on battery: battery test running"
        else
            log "UPS on battery"
            ch=$(var battery.charge) rt=$(var battery.runtime)
            notify -p high -e ups_on_battery -v "battery=$ch" -v "runtime=$rt" "UPS on battery" "battery $ch%, runtime $rt s"
        fi
        start_wait_timer
    fi ;;
online) statelog online; online ;;
lowbatt)
    statelog lowbatt
    if [ "$(status)" != OL ]; then
        ch=$(var battery.charge) rt=$(var battery.runtime)
        notify -f -p urgent -e ups_battery_low -v "battery=$ch" -v "runtime=$rt" "UPS: battery low" "battery $ch%, runtime $rt s: Safe Mode"
    fi
    safemode lowbatt ;;
nocomm)
    # NOCOMM arrives after NOCOMMWARNTIME (300 s) without communication with the UPS. DSM always
    # enters Safe Mode (even with a stuck driver and mains power present). Here by default only
    # if the UPS was on battery; for OB + unreachable UPS upsmon calls
    # SHUTDOWNCMD anyway after DEADTIME ("critical" UPS).
    statelog nocomm
    notify -p high -e ups_unreachable -v "ups=$UPS" -v "minutes=5" "UPS unreachable" "no communication with $UPS for at least 5 minutes"
    case $NOCOMM_SAFEMODE in
    always) safemode nocomm ;;
    onbatt) [ -f $ONB ] && safemode nocomm ;;
    esac ;;
fsd) statelog fsd; safemode fsd ;;
waittimeup)
    statelog waittimeup
    # during a battery test the UPS reports OB with mains present: wait for the test to end
    # (ONLINE stops the timer), then the real outage, if any, gets Safe Mode a minute later
    if testing; then
        log "SAFEMODE_AFTER elapsed during the battery test: checking again in 60 s"
        wait_timer 60
    else
        safemode waittimeup
    fi ;;
safemode-shutdowncmd) statelog shutdowncmd; safemode shutdowncmd ;;
*) sed -n '2,32p' "$0" >&2; exit 2 ;;
esac
exit 0
