#!/bin/sh
# smartd -M exec /usr/share/smartmontools/smartd-runner (Debian default in /etc/smartd.conf)
# runs the scripts in this directory: $1 = file with the full message, SMART_* variables.
# Works for SATA disks and NVMe drives (DEVICESCAN finds both).
[ -x /usr/lib/synodeb/notify ] || exit 0     # package removed, this conffile left
case "${SMART_FAILTYPE:-}" in
EmailTest) prio=low ;;
Health|FailedHealthCheck|CurrentPendingSector|OfflineUncorrectableSector|FailedReadSmartData) prio=urgent ;;
*) prio=high ;;
esac
if [ -n "${1:-}" ] && [ -r "$1" ]; then
    /usr/lib/synodeb/notify -p $prio "SMART ${SMART_DEVICE:-?}: ${SMART_FAILTYPE:-error}" - < "$1"
else
    /usr/lib/synodeb/notify -p $prio "SMART ${SMART_DEVICE:-?}: ${SMART_FAILTYPE:-error}" "${SMART_FULLMESSAGE:-${SMART_MESSAGE:-}}"
fi
exit 0
