# UARTs identified by MMIO address (serial_core iomem_base attribute, "0x%lX"):
# front microcontroller (AMDI0020:01, MMIO 0xFEDCA000) -> /dev/synology-up
SUBSYSTEM=="tty", KERNEL=="ttyS*", ATTR{iomem_base}=="0xFEDCA000", SYMLINK+="synology-up", MODE="0600"
# serial console (AMDI0020:00, MMIO 0xFEDC9000) -> /dev/synology-console
SUBSYSTEM=="tty", KERNEL=="ttyS*", ATTR{iomem_base}=="0xFEDC9000", SYMLINK+="synology-console"
# DS920+ (geminilake): the same two UARTs on the LPSS, by PCI function (the BIOS assigns their
# addresses): microcontroller on 00:18.0, serial console on 00:18.2
SUBSYSTEM=="tty", KERNEL=="ttyS*", KERNELS=="0000:00:18.0", ATTRS{vendor}=="0x8086", SYMLINK+="synology-up", MODE="0600"
SUBSYSTEM=="tty", KERNEL=="ttyS*", KERNELS=="0000:00:18.2", ATTRS{vendor}=="0x8086", SYMLINK+="synology-console"
# The daemon drives the disk LEDs: no default trigger. Only on "add": the kernel sends a
# "change" uevent on every trigger change, and without ACTION the rule would immediately
# undo the ataN trigger set by synohwd
ACTION=="add", SUBSYSTEM=="leds", KERNEL=="syno:*", ATTR{trigger}="none"
# The internal boot flash (DOM, USB f400:f400, as DSM finds it): /dev/synoboot, synoboot1,
# synoboot2 like DSM; SYNODEB_BOOT_FLASH=1 for other programs (rynas), and hidden from udisks
# (desktops and file managers must not offer to mount or eject it). After
# 60-persistent-storage.rules, which sets ID_VENDOR_ID and ID_MODEL_ID (partitions too).
SUBSYSTEM=="block", ENV{ID_BUS}=="usb", ENV{ID_VENDOR_ID}=="f400", ENV{ID_MODEL_ID}=="f400", ENV{SYNODEB_BOOT_FLASH}="1", ENV{UDISKS_IGNORE}="1"
SUBSYSTEM=="block", ENV{SYNODEB_BOOT_FLASH}=="1", ENV{DEVTYPE}=="disk", SYMLINK+="synoboot"
SUBSYSTEM=="block", ENV{SYNODEB_BOOT_FLASH}=="1", ENV{DEVTYPE}=="partition", SYMLINK+="synoboot%n"
