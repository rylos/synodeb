[Unit]
Description=synodeb: notify the failure of %i
DefaultDependencies=no
# After= only, no Wants=: when systemd-networkd-wait-online itself fails, a Wants= would queue it
# again, it would fail again and notify again, for ever, and network-online.target would never
# be reached (with the boot stuck behind it). After= alone waits for a network-online.target
# that is being started and does not start it.
After=network-online.target
# not while shutting down: without network the notification could not go out anyway and
# would only delay the shutdown
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'systemctl status --no-pager -l -n 15 "$1" 2>&1 | /usr/lib/synodeb/notify -s unit -p high -e unit_failed -v "unit=$1" -l "unit failed: $1" -' sh %i
TimeoutStartSec=2min
